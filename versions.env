# Single source of truth for every pinned version and lab parameter.
# Sourced by every script and by the Makefile:
#   set -a; source versions.env; set +a
#
# Bump a version here and re-run `make up` — nothing else needs editing.

CLUSTER_NAME=kind-argocd-headlamp-lab

# --- kind -------------------------------------------------------------
# kind CLI version — only used by CI to install a pinned kind binary; if
# you already have kind installed locally, `make up` uses whatever you have.
# https://github.com/kubernetes-sigs/kind/releases/tag/v0.32.0
KIND_VERSION=v0.32.0
# kindest/node image, pinned by digest. Matches kind >=0.32.0.
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5

# --- ingress-nginx ------------------------------------------------------
# kind-specific static manifest, applied imperatively before Argo CD.
# https://github.com/kubernetes/ingress-nginx/releases/tag/controller-v1.15.1
INGRESS_NGINX_VERSION=controller-v1.15.1
INGRESS_NGINX_MANIFEST=https://raw.githubusercontent.com/kubernetes/ingress-nginx/${INGRESS_NGINX_VERSION}/deploy/static/provider/kind/deploy.yaml

# --- Argo CD --------------------------------------------------------------
# Upstream non-HA install manifest. The one imperative install step in
# the whole lab; everything after this is GitOps.
# https://github.com/argoproj/argo-cd/releases/tag/v3.5.1
ARGOCD_VERSION=v3.5.1
ARGOCD_INSTALL_MANIFEST=https://raw.githubusercontent.com/argoproj/argo-cd/${ARGOCD_VERSION}/manifests/install.yaml

# --- Headlamp ---------------------------------------------------------
# Helm chart pulled by Argo CD directly (never `helm install` from a script).
# https://github.com/kubernetes-sigs/headlamp/tree/main/charts/headlamp
HEADLAMP_CHART_REPO=https://kubernetes-sigs.github.io/headlamp/
HEADLAMP_CHART_VERSION=0.44.0

# --- GitOps repo source -------------------------------------------------
# Argo CD's root Application reads manifests from here. Must be pushed
# and public for `make up` to converge (see README troubleshooting).
REPO_URL=https://github.com/elveli/kind-argocd-headlamp-lab.git
TARGET_REVISION=main

# --- Hostnames ----------------------------------------------------------
# *.localtest.me resolves to 127.0.0.1 publicly, no /etc/hosts edits.
ARGOCD_HOST=argocd.localtest.me
HEADLAMP_HOST=headlamp.localtest.me

# --- CI-only tool pins ----------------------------------------------------
# Not read by scripts/*.sh — only by .github/workflows/ci.yaml, to install
# matching kubectl/helm binaries on the (otherwise bare) Linux runner.
KUBECTL_VERSION=v1.36.3
HELM_VERSION=v4.2.4
